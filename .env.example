# Copie ce fichier en .env.local et remplis les valeurs (jamais dans le code, jamais dans git).

# Supabase → Project Settings → API (ou "Connect" en haut du tableau de bord)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# La clé "anon" (legacy) ou la clé "publishable" (sb_publishable_…) : les deux fonctionnent.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Le seul email autorisé à se connecter (le tien).
ALLOWED_EMAIL=toi@exemple.com
