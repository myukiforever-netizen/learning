# Copie ce fichier en .env.local et remplis les valeurs (jamais dans le code, jamais dans git).

# Supabase → Project Settings → API (ou "Connect" en haut du tableau de bord)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# La clé "anon public" (ou "publishable") : celle que le navigateur peut voir.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optionnel mais recommandé : la clé secrète du projet (service role ou sb_secret_…).
# Elle reste sur le serveur, jamais envoyée au navigateur. Colle-la toi-même ici, jamais dans un chat.
SUPABASE_SECRET_KEY=
